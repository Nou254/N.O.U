# Application
APP_NAME=N.O.U Digital Systems
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Database
# NOTE: the application runs on MySQL (see database/schema + seeds.mysql.sql).
# Adjust user/password/host/port to your local MySQL install.
DATABASE_URL=mysql+aiomysql://root:your_mysql_password@localhost:3306/nou_database
DATABASE_ECHO=false

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Email (optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAILS_FROM_EMAIL=noreply@nou.com
# EMAILS_FROM_NAME=N.O.U Digital Systems

# Redis (optional - for caching)
# REDIS_URL=redis://localhost:6379

# AI Assessment (Groq) - required for AI-powered assessments
# Get a free API key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT=120

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
# ------------------------------------------------------------------
# CREDENTIALS - all secrets live in .env only (never in source code).
# ------------------------------------------------------------------

# Admin account (seed_admin.py / cleanup_database.py)
NOU_ADMIN_EMAIL=admin@example.com
NOU_ADMIN_PASSWORD=change-me-strong-password

# SMTP (results emails, OTP codes)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=app-password
EMAILS_FROM_EMAIL=you@gmail.com
EMAILS_FROM_NAME=N.O.U Digital Systems

# M-Pesa Daraja (STK push) - leave empty to run in simulation mode
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENV=sandbox
MPESA_CALLBACK_BASE_URL=

# Flutterwave (cards)
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
FRONTEND_BASE_URL=http://localhost:3000

# Groq API keys - per-feature pools (comma separated)
GROQ_ASSESSMENT_KEYS=
GROQ_CHATBOT_KEYS=
GROQ_COMMUNITY_KEYS=
GROQ_KEYS_PER_SECTION=10
GROQ_KEYS_TOP_UP=2

# Optional Redis (multi-worker rate limits + token revocation)
REDIS_URL=
