# API Configuration
# IMPORTANT: use the RELATIVE path so requests go through the Vite dev proxy
# (/api -> http://localhost:8000). An absolute URL like http://localhost:8000
# bypasses the proxy and gets blocked by the Content-Security-Policy
# (connect-src 'self'), breaking products/careers/admin pages.
VITE_API_BASE_URL=/api/v1

# App Configuration
VITE_APP_NAME=N.O.U Digital Systems
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_MAINTENANCE_MODE=false

# Third-party Services (optional)
VITE_GOOGLE_ANALYTICS_ID=
VITE_SENTRY_DSN=
